# Copy to .env for local Claude Code usage.
# NEVER commit .env.
INTERVALS_ICU_API_KEY=replace_me
INTERVALS_ICU_ATHLETE_ID=i123456

# Optional for Claude Code cloud setup. Store this as a cloud secret,
# not in Git. scripts/cloud-setup.sh can materialize profile.local.yaml.
# ATHLETE_PROFILE_B64=<base64 of training/profile.local.yaml>

# Optional fallback for networks with a TLS-intercepting corporate proxy
# (e.g. Zscaler), where certifi's bundled CA store doesn't trust the
# proxy's injected root certificate. See scripts/run-mcp.sh.
# MCP_TRUST_SYSTEM_CERTS=1
